NEXT=<PLAN 第 54 行 03e 片的日期无关规范 ID 片段，间接形式记录，裁定 6>
shopt -u nullglob（前提：nullglob off，未匹配 glob 按字面传给 ls 由其 rc2 经 ! 判缺席）

gate1: ! ls -d "$PROJECT"/specs/*"$NEXT" 2>/dev/null  → 缺席（PASS）
